{
  "name": "git-wtree",
  "version": "0.8.0",
  "description": "Git worktree manager with .env syncing and IDE integration",
  "type": "module",
  "bin": {
    "gitwtree": "dist/index.js",
    "gwt": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "postbuild": "chmod +x dist/index.js",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build && npm run typecheck:tests",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "git",
    "worktree",
    "cli",
    "ide",
    "dev-tools"
  ],
  "author": "Lionel Giberné",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liogi/git-wtree.git"
  }
}
